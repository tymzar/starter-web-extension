{
  "name": "starter-web-extension",
  "version": "2.0.0",
  "description": "A web extension boilerplate with React 19, HeroUI v3, Tailwind CSS v4, and esbuild",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tymzar/starter-web-extension.git"
  },
  "watch": {
    "dev": {
      "patterns": [
        "src"
      ],
      "extensions": "ts,tsx,html"
    }
  },
  "scripts": {
    "start": "dotenv -e .env.local node scripts/esbuild.config.ts",
    "build": "dotenv -e .env node scripts/esbuild.config.ts",
    "build:binary": "node scripts/build-binary.ts",
    "prepublishOnly": "yarn build:binary",
    "lint": "eslint --cache --no-error-on-unmatched-pattern --ext ts,tsx {src,scripts}",
    "lint:fix": "yarn lint --fix",
    "format": "prettier --no-editorconfig --ignore-unknown src/**/*.* --check",
    "format:fix": "prettier --no-editorconfig --ignore-unknown src/**/*.* --write",
    "test:e2e": "playwright test",
    "test:docker": "docker compose up playwright-tests --build --exit-code-from playwright-tests",
    "test:docker:update-snapshots": "docker compose run --rm playwright-tests yarn test:e2e --update-snapshots",
    "prettier:fix": "prettier --no-editorconfig src/'**/*.{ts,tsx,js,css,html,md}' --write",
    "knip": "knip",
    "semantic-release": "semantic-release"
  },
  "type": "module",
  "bin": "bin/create-web-extension.js",
  "files": [
    "bin/",
    "src/",
    "e2e-tests/",
    "scripts/",
    "eslint.config.js",
    "knip.config.ts",
    "playwright.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "Dockerfile",
    "docker-compose.yml",
    ".gitignore",
    ".yarnrc.yml",
    ".env.example",
    ".github/dependabot.yml",
    ".github/workflows/pull-request-check.yml",
    ".github/workflows/package-extension.yml"
  ],
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@iconify/react": "6.0.3",
    "@inquirer/prompts": "8.7.4",
    "@internationalized/date": "3.12.4",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "chart.js": "4.6.1",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@craftamap/esbuild-plugin-html": "0.9.0",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "0.3.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "dotenv-cli": "7.2.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-clean": "1.0.1",
    "esbuild-plugin-copy": "2.1.1",
    "esbuild-style-plugin": "1.6.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "79.0.0",
    "knip": "6.43.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2"
  },
  "packageManager": "yarn@4.9.3"
}
